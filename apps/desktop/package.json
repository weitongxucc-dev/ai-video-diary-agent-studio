{
  "name": "ai-video-diary-studio",
  "version": "0.11.0-test.4",
  "description": "智能视频日记 — macOS 本地内容生产 Agent",
  "main": "main.js",
  "author": "AI视频日记 Contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "generate:build-identity": "node scripts/generate-build-identity.js",
    "test:build-identity": "node scripts/build-identity-test.js",
    "test:device-identity": "node scripts/device-identity-test.js",
    "test:lifecycle": "node scripts/lifecycle-smoke.js",
    "build:web": "NEXT_PUBLIC_AUTH_MODE=\"${NEXT_PUBLIC_AUTH_MODE:-local}\"; export NEXT_PUBLIC_AUTH_MODE; node scripts/write-distribution-config.js && cd ../web && pnpm build && node ../desktop/scripts/bundle-standalone.js",
    "build:api": "cd ../api && .venv/bin/pyinstaller pyinstaller.spec --distpath ../desktop/dist --workpath ../desktop/build-api --clean --noconfirm",
    "build:services": "pnpm build:web && pnpm build:api",
    "build": "pnpm build:services && pnpm generate:build-identity && electron-builder --mac",
    "build:mac": "pnpm build",
    "pack": "pnpm build:services && pnpm generate:build-identity && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.aivideodiary.studio",
    "productName": "Yaohe Studio",
    "artifactName": "智能视频日记 0.11 测试版-${version}-${arch}.${ext}",
    "copyright": "MIT License",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "minimumSystemVersion": "12.0",
      "icon": "assets/icon.icns",
      "entitlements": "assets/entitlements.plist",
      "entitlementsInherit": "assets/entitlements.plist",
      "hardenedRuntime": true,
      "extendInfo": {
        "CFBundleName": "Yaohe Studio",
        "CFBundleDisplayName": "曜核1.0",
        "NSMicrophoneUsageDescription": "AI视频日记需要使用麦克风进行语音指令输入",
        "NSDesktopFolderUsageDescription": "AI视频日记需要访问桌面文件夹读取知识库和视频文件"
      }
    },
    "dmg": {
      "title": "曜核1.0",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ],
      "window": { "width": 540, "height": 380 }
    },
    "files": [
      "main.js",
      "device-identity.js",
      "runtime/**/*.js",
      "preload.js",
      "build-identity.generated.json",
      "assets/**/*"
    ],
    "beforePack": "./scripts/generate-build-identity.js",
    "extraResources": [
      { "from": "dist/api-server", "to": "api-server" },
      { "from": "../api/model_workers", "to": "model-workers", "filter": ["**/*.py"] },
      { "from": "../api/agent_tools", "to": "agent-tools", "filter": ["**/*.ts"] },
      { "from": "../web/.next/standalone-bundled/apps/web", "to": "web", "filter": ["**/*"] }
    ],
    "publish": {
      "provider": "github",
      "owner": "weitongxucc-dev",
      "repo": "ai-video-diary-agent-studio"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
