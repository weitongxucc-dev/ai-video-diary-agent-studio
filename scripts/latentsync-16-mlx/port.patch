+def _video_frames(path):
+    capture = cv2.VideoCapture(path)
+    try:
+        if not capture.isOpened():
+            raise ValueError("Could not open the normalized LatentSync video")
+        while True:
+            success, frame = capture.read()
+            if not success:
+                break
+            yield cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
+    finally:
+        capture.release()
+
+
+def _read_window(frames, count):
+    window = list(islice(frames, count))
+    if len(window) != count:
+        raise ValueError("Normalized LatentSync video ended before the narration frames")
+    return window
+
+
