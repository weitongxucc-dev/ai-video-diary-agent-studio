{
  "name": "ai-video-diary-agent-studio",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:web": "corepack pnpm --dir apps/web dev",
    "build:web": "corepack pnpm --dir apps/web build",
    "lint:web": "corepack pnpm --dir apps/web lint",
    "test:web-contract": "node apps/web/scripts/workflow-contract-check.mjs",
    "test:design-system": "node apps/web/scripts/modern-desktop-contract-check.mjs",
    "test:pixel-style": "pnpm run test:design-system",
    "dev:api": "cd apps/api && uv run uvicorn app.main:create_app --factory --reload --port 8000",
    "test:api": "cd apps/api && uv run pytest",
    "test:web": "corepack pnpm --dir apps/web test",
    "test": "pnpm run test:web-contract && pnpm run test:design-system && pnpm run test:web"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "3.25.76"
  }
}
