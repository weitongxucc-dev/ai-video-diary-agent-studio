# =============================================================================
# AI视频日记 Agent Studio — 环境配置模板
# =============================================================================
# 复制此文件为 .env 并填入你的实际值。
# 启动应用前至少需要配置 DEEPSEEK_API_KEY（AI 生成能力）。
#
# cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# 内测账号与工作区（邀请制）— 发布版必填
# ---------------------------------------------------------------------------
# Supabase 项目 URL。前端仅使用 publishable key；绝不可填 service role key。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# FastAPI 用于验证访问令牌和服务端工作区授权。
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 只在受信任的后端使用；严禁以 NEXT_PUBLIC_ 前缀暴露。
SUPABASE_SECRET_KEY=
# JWT 受众（默认 authenticated，一般无需修改）。
SUPABASE_JWT_AUDIENCE=authenticated
# 可选：自定义 JWT issuer；默认从 SUPABASE_URL 派生为 {URL}/auth/v1。
SUPABASE_JWT_ISSUER=
# 邀请邮件打开的 HTTPS 地址，必须已加入 Supabase 的 Redirect URLs。
AUTH_INVITE_REDIRECT_URL=

# ---------------------------------------------------------------------------
# AI 模型 — 必填
# ---------------------------------------------------------------------------
# DeepSeek API Key（从 platform.deepseek.com 获取）
DEEPSEEK_API_KEY=
# DeepSeek API 地址（默认即可）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型版本
DEEPSEEK_MODEL=deepseek-v4-flash

# ---------------------------------------------------------------------------
# Obsidian 知识库 — 推荐配置
# ---------------------------------------------------------------------------
# Obsidian Vault 路径（用于读取你的笔记作为选题素材）
OBSIDIAN_VAULT_PATH=

# ---------------------------------------------------------------------------
# 视频目录 — 推荐配置
# ---------------------------------------------------------------------------
# 待处理视频的存放目录（录好的视频放这里，应用会自动检测）
VIDEO_INBOX_PATH=~/Movies/AI视频日记/01_待处理视频
# 处理后视频的输出目录
VIDEO_OUTPUT_PATH=~/Movies/AI视频日记/06_待发布成片
# 剪映草稿输出目录
DRAFT_OUTPUT_PATH=~/Movies/AI视频日记/05_剪映草稿
# 剪映草稿根目录（用于自动导入剪映）
JIANYING_DRAFT_ROOT_PATH=~/Movies/JianyingPro/User Data/Projects/com.lveditor.draft
# 数据库文件路径（存储所有 episode、脚本、反馈数据）
DATABASE_PATH=~/Movies/AI视频日记/agent.sqlite3

# ---------------------------------------------------------------------------
# 语音识别（ASR）— 可选
# ---------------------------------------------------------------------------
# 腾讯云 ASR 凭证（从 console.cloud.tencent.com 获取）
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_ASR_REGION=ap-shanghai
TENCENTCLOUD_ASR_ENGINE_MODEL_TYPE=16k_zh_en
TENCENTCLOUD_ASR_MAX_WAIT_SECONDS=120
TENCENTCLOUD_ASR_POLL_INTERVAL_SECONDS=2
# 本地音频直传最大字节数（超过此大小需走 COS URL 上传）
TENCENTCLOUD_ASR_MAX_LOCAL_AUDIO_BYTES=5000000

# ---------------------------------------------------------------------------
# 本地 Whisper — 可选（重录检测）
# ---------------------------------------------------------------------------
# Whisper Python 路径（推荐使用虚拟环境中的 Python）
# LOCAL_WHISPER_PYTHON_PATH=
# Whisper 模型文件路径（推荐 small 或 medium 模型）
# LOCAL_WHISPER_MODEL_PATH=
# Whisper 语言
LOCAL_WHISPER_LANGUAGE=zh

# ---------------------------------------------------------------------------
# 外部信息源 — 可选
# ---------------------------------------------------------------------------
# Product Hunt API Token（从 api.producthunt.com 获取）
PRODUCT_HUNT_TOKEN=
# Product Hunt API 地址
PRODUCT_HUNT_API_URL=https://api.producthunt.com/v2/api/graphql
# Hermes 雷达日报路径（Product Hunt + 观猹 聚合报告）
HERMES_RADAR_PATH=~/Desktop/product-hunt-raw/daily-reports
# 额外信息源 URL（逗号分隔，用于选题素材发现）
TOPIC_SOURCE_URLS=https://watcha.cn/
